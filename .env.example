# ==========================================
# Flask Application Configuration
# ==========================================
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_string

# ==========================================
# Database Configuration
# ==========================================
# Primary Database (PostgreSQL)
SQLALCHEMY_DATABASE_URI=postgresql://user:password@host:port/dbname

# SQLite Fallback (Comment out the above and uncomment below for local dev)
# SQLALCHEMY_DATABASE_URI=sqlite:///app.db

# ==========================================
# Supabase Configuration
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ==========================================
# Telegram Integration
# ==========================================
TELEGRAM_BOT_TOKEN=1234567890:your_bot_token
# Optional: For Telegram Client/Userbot features if needed
API_ID=your_api_id
API_HASH=your_api_hash
